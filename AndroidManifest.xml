<?xml version="1.0" encoding="utf-8"?>
<!--
  org.lumen.installer ("Lumen Installer"): runs on the projector's own XGIMI firmware and starts Lumen OS once as a
  trial, without a computer. It knows no model: it reads the projector's model code, finds it in the signed list of
  projectors (devices.json on the release "index" of Project-Lumen-OS/lumen-installer) and
  follows that entry: which release channel, which certificates, what may run on this firmware. It downloads the
  latest signed release for exactly that model, verifies it on the projector and hands it to the system's trial tool
  through XGIMI's service access. An ordinary third-party app: no sharedUserId, no platform privileges, its own key.
  minSdk 29, targetSdk 29.
  1.0.6: on an installed Lumen OS it may update one of its apps that the signed list names for that Lumen OS version
  (REQUEST_INSTALL_PACKAGES: the system installer asks the user, the app never installs anything by itself).
  1.0.7: images and app updates download over several connections at once and go on after a break.
  1.0.8: the firmware card shows the FPGA firmware next to its type, problem reports try the new server address first.
  1.0.9: Lumen OS comes over the network only: no USB stick or LumenOS folder and no storage permission, a model that
  only a computer installs shows no build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lumen.installer"
    android:versionCode="109"
    android:versionName="1.0.9">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon_installer"
        android:banner="@drawable/banner_installer"
        android:allowBackup="false"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- About (the round "i"): versions, projector, what happens, the way back, licenses, project page -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <service
            android:name=".WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
