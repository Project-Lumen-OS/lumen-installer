<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0
     The colour of a lumen_ic_* icon by the state of the row it sits in (the Lumen tokens, org.lumen.ui.Tokens):
     disabled = OFF_TEXT, focused (white text on the accent row) = white, otherwise the TITLE text colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#FF5D6570" />
    <item android:state_focused="true" android:color="#FFFFFFFF" />
    <item android:state_pressed="true" android:color="#FFFFFFFF" />
    <item android:color="#FFE6E9EE" />
</selector>
